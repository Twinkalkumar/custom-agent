# Copy this file to .env and fill in real values. Never commit .env itself
# (add it to .gitignore) since it holds a real API key.

# --- Choose the backend ---
# "ollama" = fully local (default, no key needed)
# "openai" = cloud API (OpenAI, or any OpenAI-compatible provider)
LLM_PROVIDER=ollama

# --- Only needed if LLM_PROVIDER=openai ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional: point at an OpenAI-compatible provider instead of api.openai.com
# e.g. Groq:      https://api.groq.com/openai/v1   (model: llama-3.1-70b-versatile)
# e.g. Together:  https://api.together.xyz/v1
# OPENAI_BASE_URL=
